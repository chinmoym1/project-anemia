# ============================================================
# HEMAVIEW — Environment Variables Template
# Copy this to .env and fill in real values
# NEVER commit .env to Git
# ============================================================

# App
APP_NAME=HemaView API
APP_VERSION=1.0.0
DEBUG=False
ENVIRONMENT=production

# Security — GENERATE STRONG RANDOM VALUES FOR PRODUCTION
# Run: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_USE_STRONG_RANDOM_64_CHAR_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# AES-256 Encryption Key
# Run: python -c "import secrets; print(secrets.token_urlsafe(32))"
ENCRYPTION_KEY=CHANGE_ME_USE_STRONG_RANDOM_32_CHAR_KEY

# Database — Render PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/hemaview_db

# CORS — add your frontend URLs
ALLOWED_ORIGINS=["https://yourapp.com","http://localhost:3000"]

# Upload limits
MAX_IMAGE_SIZE_MB=20
UPLOAD_DIR=/tmp/hemaview_uploads

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
INFERENCE_RATE_PER_MINUTE=10

# ML Model paths
MODEL_PATH=app/ml/models/hb_regressor.pkl
MODEL_VERSION=2.1
